# Repo Analyzer Agent — Environment Variables

# PostgreSQL connection (same DB as the backend)
DATABASE_URL=postgresql://user:password@localhost:5432/autofix_agent

# OpenAI API key for text-embedding-3-small
OPENAI_API_KEY=sk-...

# Comma-separated list of file extensions to index (without leading dot)
# Defaults to this list if not set
INDEXABLE_EXTENSIONS=py,ts,tsx,js,jsx,go,java,rb,rs,cpp,c,h
